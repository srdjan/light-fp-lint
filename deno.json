{
  "name": "@light-fp/deno-lint-plugin",
  "version": "0.3.0",
  "exports": {
    ".": "./src/mod.ts"
  },
  "lint": {
    "exclude": [
      "examples"
    ],
    "rules": {
      "include": [
        "recommended"
      ]
    },
    "plugins": [
      "./src/mod.ts"
    ]
  },
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0"
  },
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test -A",
    "examples:lint": "deno lint --config examples/deno.json examples",
    "ci": "deno fmt --check && deno check src tests && deno lint && deno test -A"
  }
}
