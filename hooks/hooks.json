{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-run=deno \"${PLUGIN_ROOT}/hooks/verify.ts\"",
            "commandWindows": "deno run --quiet --allow-read --allow-run=deno \"%PLUGIN_ROOT%/hooks/verify.ts\"",
            "timeout": 30,
            "statusMessage": "Validating Light FP"
          }
        ]
      }
    ]
  }
}
