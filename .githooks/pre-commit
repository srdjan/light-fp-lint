#!/bin/sh
# The whole gate runs before a commit lands. There is no remote CI behind this
# hook, so a skipped run is a hole nothing else closes.
#
# The gate runs on a copy of the staged files, which is what the commit
# records. Unstaged edits and untracked files cannot change the result.
#
# Enable it once per clone:
#
#   git config core.hooksPath .githooks
#
set -e
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"
cd "$snapshot"
deno task ci
